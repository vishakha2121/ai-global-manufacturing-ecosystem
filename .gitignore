# ─────────────────────────────────────────────
# 🔐 SECRETS & ENVIRONMENT VARIABLES (CRITICAL!)
# ─────────────────────────────────────────────
.env
.env.local
.env.development
.env.production
.env.test
*.env
!.env.example

# ─────────────────────────────────────────────
# 🗄️ DATABASE FILES (SQLite)
# ─────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
database/manufacturing.db

# ─────────────────────────────────────────────
# 🐍 PYTHON
# ─────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
env/
ENV/
env.bak/
venv.bak/
.venv/
.venv*/
backend/venv/
backend/env/

# Python testing
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
*.cover

# Python IDE
*.pyc
*.pyo
__pycache__/

# Jupyter Notebooks
.ipynb_checkpoints/

# ─────────────────────────────────────────────
# 🟩 NODE / REACT / FRONTEND
# ─────────────────────────────────────────────
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build output
dist/
dist-ssr/
build/
frontend/dist/
frontend/build/
.vite/
frontend/.vite/

# Cache
.cache/
.parcel-cache/
.eslintcache
.stylelintcache

# Next.js (if used)
.next/
out/

# ─────────────────────────────────────────────
# 💻 IDE / EDITORS
# ─────────────────────────────────────────────
# VS Code
.vscode/
!.vscode/extensions.json
*.code-workspace

# JetBrains (PyCharm, WebStorm, IntelliJ)
.idea/
*.iml
*.ipr
*.iws

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
