# AI Global Manufacturing Ecosystem - .gitignore
# ============================================================

# ─────────────────────────────────────────────
# 🔐 SECRETS & ENVIRONMENT VARIABLES (CRITICAL!)
# ─────────────────────────────────────────────
.env
.env.local
.env.development
.env.production
.env.test
*.env
!.env.example

# ─────────────────────────────────────────────
# 🗄️ DATABASE FILES (SQLite)
# ─────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
database/manufacturing.db

# ─────────────────────────────────────────────
# 🐍 PYTHON
# ─────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
env/
ENV/
env.bak/
venv.bak/
.venv/
.venv*/
backend/venv/
backend/env/

# Python testing
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
*.cover

# Python IDE
*.pyc
*.pyo
__pycache__/

# Jupyter Notebooks
.ipynb_checkpoints/

# ─────────────────────────────────────────────
# 🟩 NODE / REACT / FRONTEND
# ─────────────────────────────────────────────
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build output
dist/
dist-ssr/
build/
frontend/dist/
frontend/build/
.vite/
frontend/.vite/

# Cache
.cache/
.parcel-cache/
.eslintcache
.stylelintcache

# Next.js (if used)
.next/
out/

# ─────────────────────────────────────────────
# 💻 IDE / EDITORS
# ─────────────────────────────────────────────
# VS Code
.vscode/
!.vscode/extensions.json
*.code-workspace

# JetBrains (PyCharm, WebStorm, IntelliJ)
.idea/
*.iml
*.ipr
*.iws

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~
.vim/

# Nano
*.save

# Eclipse
.classpath
.project
.settings/

# NetBeans
nbproject/

# ─────────────────────────────────────────────
# 🖥️ OPERATING SYSTEMS
# ─────────────────────────────────────────────
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
ehthumbs.db

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~
.directory
.Trash-*

# ─────────────────────────────────────────────
# 📊 LOGS & TEMP FILES
# ─────────────────────────────────────────────
*.log
logs/
log/
*.out
temp/
tmp/
.cache/

# ─────────────────────────────────────────────
# 🔒 SSL / CERTIFICATES
# ─────────────────────────────────────────────
*.pem
*.key
*.crt
*.csr
*.p12
*.pfx

# ─────────────────────────────────────────────
# 📦 PACKAGE MANAGERS
# ─────────────────────────────────────────────
package-lock.json
yarn.lock
pnpm-lock.yaml
Pipfile.lock
poetry.lock

# ─────────────────────────────────────────────
# 🧪 TESTING & COVERAGE
# ─────────────────────────────────────────────
.coverage
.coverage.*
coverage.xml
*.cover
*.py,cover
.pytest_cache/
.hypothesis/
htmlcov/
.tox/

# ─────────────────────────────────────────────
# 🚀 BUILD & DEPLOYMENT
# ─────────────────────────────────────────────
backend/staticfiles/
frontend/static/
*.zip
*.tar.gz
*.rar
*.7z

# ─────────────────────────────────────────────
# 🎥 MEDIA & ASSETS (optional - uncomment if needed)
# ─────────────────────────────────────────────
# *.jpg
# *.jpeg
# *.png
# *.gif
# *.mp4

# ─────────────────────────────────────────────
# 🧠 AI / ML ARTIFACTS
# ─────────────────────────────────────────────
*.h5
*.pkl
*.joblib
*.model
*.weights
*.pt
*.pth
*.onnx
models_store/
checkpoints/

# ─────────────────────────────────────────────
# 📁 PERSONAL / MISC
# ─────────────────────────────────────────────
*.bak
*.backup
*.orig
*.rej
.sass-cache/
*.css.map
*.js.map

# ─────────────────────────────────────────────
# 📝 NOTES (personal files)
# ─────────────────────────────────────────────
notes/
personal/
*.private
