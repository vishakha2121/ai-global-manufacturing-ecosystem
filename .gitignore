.env
.env.local
.env.development
.env.production
.env.test
*.env
!.env.example

# ─────────────────────────────────────────────
# 🗄️ DATABASE FILES (SQLite)
# ─────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
database/manufacturing.db

# ─────────────────────────────────────────────
# 🐍 PYTHON
# ─────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
